# EchoMe Frontend Environment Variables

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=EchoMe

# GIPHY API (for GIF picker — Tenor discontinued June 2026)
NEXT_PUBLIC_GIPHY_API_KEY=

# Gmail sent-mail ingest UI. Backend has its own GMAIL_INGEST_ENABLED gate.
NEXT_PUBLIC_GMAIL_CONNECT_ENABLED=false
